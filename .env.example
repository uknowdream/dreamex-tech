# Server-side variables for the optional Shared Team Workspace.
# Add these to Vercel Project Settings. Never prefix them with VITE_.
KV_REST_API_URL=https://your-upstash-redis-rest-url
KV_REST_API_TOKEN=replace-with-server-only-token
DREAMEX_WORKSPACE_TOKEN=replace-with-at-least-32-random-characters
# Optional exact comma-separated origins:
DREAMEX_ALLOWED_ORIGINS=https://dreamex.tech,https://www.dreamex.tech
